{
  "name": "mcdis",
  "version": "1.0.0",
  "description": "mcdis is a node-based application that allows you to stream a Minecraft server console to Discord, enabling remote and efficient server management through a Discord bot. inspired by McDis-RCON",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./mod": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "bin": {
    "mcdis-node": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliyya/mcdis-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliyya/mcdis-node/issues"
  },
  "homepage": "https://github.com/eliyya/mcdis-node#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
